<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This controls the headless TNT overlay display resolution used by the TNT button on the home page."
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Preset"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/tntOverlayPresetSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Width"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/tntOverlayWidthEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="1920"
        android:inputType="number"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Height"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/tntOverlayHeightEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="1080"
        android:inputType="number"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="DPI"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/tntOverlayDpiEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="216 or 320"
        android:inputType="number"
        android:singleLine="true" />
</LinearLayout>
