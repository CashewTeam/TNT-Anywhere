<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/initializationGuideButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="打开初始化配置向导" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/shizukuStatusPrefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shizuku 状态：" />

                <TextView
                    android:id="@+id/shizukuStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/shizukuPermissionBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="授权"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="无障碍仅作为没有 Shizuku 时的兼容保留选项，默认关闭。"
                android:textColor="#666666"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="无障碍状态：" />

                <TextView
                    android:id="@+id/accessibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/accessibilityPermissionBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="授权"
                    android:visibility="gone" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/disableAccessibilityCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="启用"
                    android:textColor="@android:color/black"
                    app:showText="false"
                    app:switchMinWidth="48dp"
                    app:thumbTint="#4CAF50"
                    app:trackTint="#664CAF50" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="悬浮窗状态：" />

                <TextView
                    android:id="@+id/overlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/overlayPermissionBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="授权"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoRotateCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="自动旋转"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoScaleCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="自动缩放去黑边"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoScreenOffCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="自动熄屏"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/useBlackImageCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="使用黑色图片模拟熄屏"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/disableUsbAudioCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="禁用 USB 外接屏音频输出"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoMatchAspectRatioCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="自动调整主屏宽高比以适配扩展屏"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/showFloatingInMirrorModeCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="镜像模式下也显示悬浮返回键"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/preventAutoLockCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="阻止自动锁屏"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/smartisanCpusetBoostCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Smartisan 后台串流性能模式"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/useAndroidCursorOverlayCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="显示安卓端叠加光标（兼容模式）"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/mapMouseToTouchCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="将鼠标事件映射为触控（兼容模式）"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoHideFloatingCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="自动隐藏悬浮返回键"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoConnectClientCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="自动连接 Moonlight 客户端"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:showText="false"
            app:switchMinWidth="48dp"
            app:thumbTint="#4CAF50"
            app:trackTint="#664CAF50" />

        <LinearLayout
            android:id="@+id/clientConnectionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Spinner
                android:id="@+id/clientSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/connectClientButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tntOverlaySettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TNT 启动与备用方案"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentTntOverlaySettingsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#666666"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/adaptTntResolutionToClientCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="适应客户端分辨率"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:showText="false"
                app:switchMinWidth="48dp"
                app:thumbTint="#4CAF50"
                app:trackTint="#664CAF50" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoCloseTntOnClientDisconnectCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="客户端断开后自动关闭 TNT"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:showText="false"
                app:switchMinWidth="48dp"
                app:thumbTint="#4CAF50"
                app:trackTint="#664CAF50" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="主页 TNT 按钮默认已经使用免 Root 的原生方案。这里保留旧的 overlay 方式作为备用，仅在排障或兼容性需要时使用。"
                android:textColor="#666666"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Root 状态：" />

                <TextView
                    android:id="@+id/backupTntRootStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未检查" />

                <Button
                    android:id="@+id/checkBackupTntRootButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="检查" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TNT 调试选项：" />

                <TextView
                    android:id="@+id/backupTntDebugStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="待检查" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/backupTntDebugSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@android:color/black"
                    app:showText="false"
                    app:switchMinWidth="48dp"
                    app:thumbTint="#4CAF50"
                    app:trackTint="#664CAF50" />
            </LinearLayout>

            <Button
                android:id="@+id/backupTntOverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="启动备用 TNT overlay" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="该方式会执行旧的 overlay_display_devices 与 persist.easycast.show_overlay_display 流程，通常需要 Root，且修改 TNT 调试选项后重启系统才能完全生效。"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="主页默认方案和这里的备用 overlay 方案都会读取下方这组显示参数。默认是 1080P/216dpi，4K 和平板预设使用 320dpi。"
                android:textColor="#666666"
                android:textSize="13sp" />

            <Button
                android:id="@+id/editTntOverlaySettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="编辑 TNT 显示分辨率" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/encoderSettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="编码设置"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentEncoderSettingsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#666666"
                android:textSize="13sp" />

            <Button
                android:id="@+id/viewRecentHandshakeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="查看最近握手信息" />

            <Button
                android:id="@+id/viewRecentControlInputButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="查看最近控制输入统计" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="说明：H.264 默认用于更好的实时性能和兼容性；H.265 更省带宽，但部分设备可能延迟更高。码率比例会按 Moonlight 请求码率缩放。最大 FPS 默认 60，可限制编码器负载。FEC 是网络纠错冗余，局域网稳定时建议 0，网络抖动时再提高。"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Codec"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/encoderCodecSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="码率比例（25-200）"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/encoderBitratePercentEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="码率模式"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/encoderBitrateModeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="编码复杂度（0-10）"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/encoderComplexityEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="I 帧间隔（1-10 秒）"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/encoderIFrameIntervalEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="最大编码 FPS（1-240）"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/encoderMaxFpsEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="FEC 百分比（0-50）"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/streamFecPercentEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderLowLatencyCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="启用低延迟编码提示"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:showText="false"
                app:switchMinWidth="48dp"
                app:thumbTint="#4CAF50"
                app:trackTint="#664CAF50" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderDisableBFramesCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="禁用 B 帧"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:showText="false"
                app:switchMinWidth="48dp"
                app:thumbTint="#4CAF50"
                app:trackTint="#664CAF50" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderRealtimePriorityCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="启用实时优先级提示"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:showText="false"
                app:switchMinWidth="48dp"
                app:thumbTint="#4CAF50"
                app:trackTint="#664CAF50" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderDynamicFrameRateCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="动态帧率（静止画面降低编码帧率）"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:showText="false"
                app:switchMinWidth="48dp"
                app:thumbTint="#4CAF50"
                app:trackTint="#664CAF50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/resetEncoderSettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="恢复默认" />

                <Button
                    android:id="@+id/saveEncoderSettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="保存编码设置" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/aboutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="关于"
            android:textSize="16sp" />

        <Button
            android:id="@+id/screenSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="屏幕设置（实验性）"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="实验性选项：不同 ROM 对显示参数接口兼容性不一致，修改外接屏分辨率、DPI、刷新率或旋转可能造成画面异常。内置屏幕只允许查看。"
            android:textColor="#8A5A00"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
